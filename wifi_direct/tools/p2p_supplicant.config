# Private executable only: do not install over the system supplicant.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_TLS=openssl
CONFIG_WPS=y
CONFIG_WPS2=y
CONFIG_P2P=y
CONFIG_AP=y
# Persistent GO credentials/client lists are saved by the root-owned service.
CONFIG_NO_CONFIG_BLOBS=y
CFLAGS += -DCONFIG_VIVO_P2P_GROUP_ONLY
