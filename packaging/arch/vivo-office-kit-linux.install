post_install() {
    # A user-level launcher or command takes precedence over the system package.
    # Do not delete or overwrite files in users' home directories from pacman.
    if command -v getent >/dev/null 2>&1; then
        getent passwd | while IFS=: read -r name _ uid _ _ home _; do
            [ "$uid" -ge 1000 ] 2>/dev/null || continue
            if [ -e "$home/.local/bin/vokit" ] || [ -e "$home/.local/share/applications/io.github.vivolinux.OfficeKit.desktop" ]; then
                echo "VOkit: $name has a personal installation that may override this package; remove the old personal installation before launching."
            fi
        done
    fi
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules || true
        udevadm trigger --subsystem-match=video4linux || true
    fi
    if [ -d /sys/module/v4l2loopback ]; then
        echo 'VOkit: existing virtual camera module kept running; select its Vivo Phone device.'
    elif command -v modinfo >/dev/null 2>&1 && modinfo v4l2loopback >/dev/null 2>&1; then
        modprobe v4l2loopback || echo 'VOkit: module load failed; check DKMS, running-kernel headers and Secure Boot signing.'
    else
        echo 'VOkit webcam: install v4l2loopback-dkms plus headers matching the running kernel, then reboot.'
    fi
    echo 'VOkit: run vokit as your regular user. Phone consent prompts remain interactive.'
}

post_upgrade() {
    post_install
}
